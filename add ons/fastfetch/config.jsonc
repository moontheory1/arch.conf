{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "/$HOME/Pictures/fastfetch/5.png",
        "type": "kitty",
        "width": 25,
        "height": 13,
        "padding": {
            "top": 1,
            "right": 3
        }
    },
    "display": {
        "separator": ""
    },
    "modules": [
        {
            "type": "title",
            "format": "{ ! moonlight <3 @ moonlight }"
        },
        "break",
        {
            "type": "os",
            "key": "󰣇 os       ~>     ",
            "keyColor": "white",
            "format": "Arch (BTW)"
        },
        {
            "type": "kernel",
            "key": "󰌽 kernel   ~>     ",
            "keyColor": "white",
            "format": "{1} {2}"
        },
        {
            "type": "wm",
            "key": "󰨇 wm       ~>     ",
            "keyColor": "white"
        },
        "break",
        {
            "type": "cpu",
            "key": "󰍛 cpu      ~>     ",
            "keyColor": "white"
        },
        {
            "type": "gpu",
            "key": "󰢮 gpu      ~>     ",
            "keyColor": "white"
        },
        {
            "type": "memory",
            "key": "󰑭 ram      ~>     ",
            "keyColor": "white"
        },
        "break",
        {
            "type": "uptime",
            "key": "󰅐 uptime   ~>    ",
            "keyColor": "white"
        },
        "break",
        {
            "type": "disk",
            "key": "󰉋 disk     ~>    ",
            "keyColor": "#ffffff",
            "format": "{1} / {2} {3}"
        }
    ]
}
